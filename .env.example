# --- SphereWeb : variables d'environnement ---
# Copier en .env.local (dev) ou configurer sur l'hébergement (prod).

# --- SMTP IONOS (formulaire de contact) ---
# Doc IONOS : serveur smtp.ionos.fr, port 587 (STARTTLS) ou 465 (SSL)
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=david.antoina@sphere-web.com
SMTP_PASS=motdepasse_de_la_boite_mail

# Expéditeur et destinataire des messages du formulaire
MAIL_FROM="SphereWeb <david.antoina@sphere-web.com>"
MAIL_TO=david.antoina@sphere-web.com
