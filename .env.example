# --- SphereWeb : variables d'environnement ---
# Copier en .env.local (dev) ou configurer dans hPanel Hostinger (prod).

# --- SMTP (formulaire de contact) ---
# Boîte mail Hostinger : david-antoina@sphereweb-dev.com
# Serveur Hostinger : smtp.hostinger.com, port 465 (SSL).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=david-antoina@sphereweb-dev.com
SMTP_PASS=motdepasse_de_la_boite_mail

# Expéditeur et destinataire des messages du formulaire
MAIL_FROM="SphereWeb <david-antoina@sphereweb-dev.com>"
MAIL_TO=david-antoina@sphereweb-dev.com

# DEV UNIQUEMENT — à mettre à true seulement si un antivirus local (Norton, ESET…)
# inspecte le SMTP et fait échouer la vérification du certificat. Jamais en prod.
SMTP_TLS_INSECURE=false

# --- Démo IA (génération de maquette — /demo) ---
# Clé de la Console API Anthropic : https://console.anthropic.com
# DISTINCTE de l'abonnement claude.ai (qui ne donne pas accès à l'API) et
# facturée à part. Configurer un plafond de dépense (budget cap) côté Console.
# Laisser vide désactive proprement la démo (message « indisponible »).
ANTHROPIC_API_KEY=
